# Create .env from this file; do not commit your real credentials.
# Either provider block can be left blank to skip that provider.

# Cloudflare (zones, DNS, SSL, DNSSEC, certificates, billing)
CLOUDFLARE_API_TOKEN=replace_with_your_token
CLOUDFLARE_TIMEOUT_SECONDS=20
CLOUDFLARE_RETRIES=3
RDAP_TIMEOUT_SECONDS=12

# GoDaddy (registrar: expiry, lock, privacy, auto-renew, DNS)
# Production: https://api.godaddy.com | OTE testing: https://api.ote-godaddy.com
GODADDY_API_KEY=replace_with_your_key
GODADDY_API_SECRET=replace_with_your_secret
GODADDY_API_BASE_URL=https://api.godaddy.com
GODADDY_TIMEOUT_SECONDS=20
GODADDY_RETRIES=3
GODADDY_MAX_WORKERS=2

# Shared
OUTPUT_DIR=output
LOG_DIR=logs
